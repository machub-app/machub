    "Compatibility not verified: it may or may not run under Whisky.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibilité non vérifiée : le jeu peut fonctionner ou non sous Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性は未検証です。Whisky で動作するかは分かりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容性未验证：在 Whisky 下可能运行，也可能无法运行。"
          }
        }
      }
    },
    "Connect Steam": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter Steam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam に接続"
          }
        },
        "zh-Hans": {
