          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apple's translator, required for DirectX 12. Needs the Game Porting Toolkit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traducteur d'Apple, indispensable pour DirectX 12. Nécessite le Game Porting Toolkit."
          }
        }
      }
    },
    "Asks the game to close, then forces it after 10 seconds.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au jeu de se fermer, puis le force au bout de 10 secondes."
          }
        }
      }
    },
    "Audio player": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecteur audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオプレーヤー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频播放器"
          }
        }
      }
    },
    "Automatic (recommended)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique (recommandé)"
          }
        }
      }
    },
    "Automatic detection": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détection automatique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测"
          }
        }
      }
    },
    "Automatic reads which DirectX version each game uses: DirectX 10/11 → DXMT, DirectX 9 and older → Wine's own renderer. Each game can override this on its page. MacHub puts the chosen DLLs next to the game and never replaces DLLs the game ships itself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique lit la version de DirectX qu'utilise chaque jeu : DirectX 10/11 → DXMT, DirectX 9 et plus ancien → le rendu de Wine. Chaque jeu peut choisir autre chose sur sa page. MacHub place les DLL choisies à côté du jeu et ne remplace jamais celles que le jeu fournit lui-même."
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible"
          }
        }
      }
    },
    "Avoid ticking options that launch the program at the end: MacHub waits for the installer to close.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite de cocher les options qui lancent le programme à la fin : MacHub attend que l'installateur se ferme."
          }
        }
      }
    },
    "Back to MacHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour à MacHub"
          }
        }
      }
    },
