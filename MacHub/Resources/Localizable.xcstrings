    "Demo title. Install it in a Whisky bottle to play.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titre de démo. Installez-le dans une bouteille Whisky pour y jouer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモタイトルです。プレイするには Whisky のボトルにインストールしてください。"
          }
        },
        "zh-Hans": {
