      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte"
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Action"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション"
          }
