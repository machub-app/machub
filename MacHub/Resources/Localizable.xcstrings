          }
        }
      }
    },
    "Taking longer than usual. Steam may be updating the game, installing a prerequisite or waiting for you in its window. MacHub keeps watching for up to 3 minutes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus long que d'habitude. Steam met peut-être le jeu à jour, installe un prérequis ou t'attend dans sa fenêtre. MacHub continue de surveiller jusqu'à 3 minutes."
