    },
    "Players report it doesn't run with Wine (ProtonDB).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les joueurs signalent qu'il ne tourne pas avec Wine (ProtonDB)."
          }
