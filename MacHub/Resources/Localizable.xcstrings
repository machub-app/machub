    "Action RPG": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RPG d'action"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション RPG"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作角色扮演"
          }
        }
      }
    },
    "Add a Windows .exe, or pin a program in Whisky: it shows up here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un .exe Windows, ou épinglez un programme dans Whisky : il apparaîtra ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows の .exe を追加するか、Whisky でプログラムをピン留めすると、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Windows .exe，或在 Whisky 中固定程序，它就会显示在这里。"
          }
        }
      }
    },
    "Add a Windows program…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un programme Windows…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows プログラムを追加…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Windows 程序…"
          }
        }
      }
    },
    "Add a car or track…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une voiture ou un circuit…"
          }
        }
      }
    },
    "Add a key in Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une clé dans les Réglages"
