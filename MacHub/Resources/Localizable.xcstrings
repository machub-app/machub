    "Minecraft version": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de Minecraft"
          }
        }
      }
    },
    "Missing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未インストール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失"
          }
        }
      }
    },
    "Missing commands: %@. Install the maintained fork (frankea/Whisky).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandes manquantes : %@. Installez le fork maintenu (frankea/Whisky)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足しているコマンド: %@。保守されているフォーク (frankea/Whisky) をインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少命令：%@。请安装仍在维护的分支 (frankea/Whisky)。"
          }
        }
      }
    },
    "Missing games from your Steam Family? Start Steam for Windows once: it syncs the family library, and MacHub picks the shared games up within a minute.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des jeux de ta Famille Steam manquent ? Démarre Steam pour Windows une fois : il synchronise la bibliothèque familiale, et MacHub récupère les jeux partagés en moins d'une minute."
          }
        }
      }
    },
    "Mod files and their backups": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de mods et leurs sauvegardes"
          }
        }
      }
    },
    "Mod manager": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionnaire de mods"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod マネージャー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模组管理器"
          }
        }
      }
    },
    "Modrinth can't be reached": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modrinth est injoignable"
          }
        }
      }
    },
    "Mods": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mods"
          }
        }
      }
    },
    "Mods folder": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier des mods"
          }
        }
      }
    },
    "Mods need the Fabric loader. MacHub creates a separate profile, “MacHub · Fabric”, with its own game folder: your current worlds and settings stay untouched.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mods ont besoin du chargeur Fabric. MacHub crée un profil séparé, « MacHub · Fabric », avec son propre dossier de jeu : tes mondes et réglages actuels restent intacts."
          }
        }
      }
    },
    "Mods on the official site": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mods sur le site officiel"
          }
        }
      }
    },
    "More like this": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le même style"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似たタイトル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多类似内容"
          }
        }
      }
    },
    "Most BeamNG.drive mods live on BeamNG's own repository, which the game has built in (Mods in its main menu). Nexus has a smaller selection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des mods BeamNG.drive se trouvent sur le dépôt de BeamNG, intégré au jeu (Mods dans son menu principal). Nexus en propose moins."
          }
        }
      }
    },
    "Most downloaded": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus téléchargés"
          }
        }
      }
    },
    "Most endorsed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus appréciés"
          }
        }
      }
    },
    "Move this Windows environment to the Trash?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre cet environnement Windows à la Corbeille ?"
          }
        }
      }
    },
    "Move this engine version to the Trash?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre cette version du moteur à la Corbeille ?"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à la Corbeille"
          }
        }
      }
    },
    "Move to Trash…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à la Corbeille…"
          }
        }
      }
    },
    "Moved to the Trash": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis à la Corbeille"
          }
        }
      }
    },
    "Moves MacHub's engines, Windows environments (with the games installed in them), logs, caches and settings to the Trash, and removes its keys from the Keychain. You choose after seeing the full list.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à la Corbeille les moteurs de MacHub, ses environnements Windows (avec les jeux installés dedans), ses journaux, caches et réglages, et retire ses clés du Trousseau. Tu décides après avoir vu la liste complète."
          }
        }
      }
    },
    "Mute": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper le son"
          }
        }
      }
    },
    "Mute %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper le son de %@"
          }
        }
