    },
    "An installer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un installateur"
          }
        }
      }
    },
    "An update is available. Steam applies it at the next launch, or choose Update Now in the … menu.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour est disponible. Steam l'applique au prochain lancement, ou choisis « Mettre à jour » dans le menu …."
          }
        }
      }
    },
    "Any compatibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute compatibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての互換性"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意兼容性"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
