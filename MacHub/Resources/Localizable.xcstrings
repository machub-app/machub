{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "%@ available": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponible(s)"
          }
        }
      }
    },
    "%@ closed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'est fermé"
          }
        }
      }
    },
    "%@ closed right after starting": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'est fermé juste après son démarrage"
          }
        }
      }
    },
    "%@ connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connectée"
          }
        }
      }
    },
    "%@ didn't start": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas démarré"
          }
        }
      }
    },
    "%@ disconnected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ déconnectée"
          }
        }
      }
    },
    "%@ installer, %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installateur %@, %@"
          }
        }
      }
    },
    "%@ is in your library. Play opens it in its bottle.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est dans ta bibliothèque. Jouer l'ouvre dans son environnement."
          }
        }
      }
    },
    "%@ is open": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est ouvert"
          }
        }
      }
    },
    "%@ is running": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur %@"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ — %@": {
      "shouldTranslate": false
    },
    "%@: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %@"
          }
        }
      }
    },
    "%lld bottle(s) · %lld game(s)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bouteille(s) · %lld jeu(x)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボトル %lld 個 · ゲーム %lld 本"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个容器 · %lld 款游戏"
          }
        }
      }
    },
    "%lld controllers connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld manettes connectées"
          }
        }
      }
    },
    "%lld environment(s) · %lld game(s)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld environnement(s) · %lld jeu(x)"
          }
        }
      }
    },
    "%lld environment(s) · Steam not set up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld environnement(s) · Steam non installé"
          }
        }
      }
    },
    "%lld games": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jeux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 本のゲーム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 款游戏"
          }
        }
      }
    },
    "%lld games, from Steam for Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jeux, depuis Steam pour Windows"
          }
        }
      }
    },
    "%lld h %lld min": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld h %lld min"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 時間 %lld 分"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时 %lld 分钟"
          }
        }
      }
    },
    "%lld note(s) to read after applying": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld note(s) à lire après l'application"
          }
        }
      }
    },
    "%lld of %lld checked": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld vérifiés"
          }
        }
      }
    },
    "%lld registry setting(s)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld réglage(s) du registre"
          }
        }
      }
    },
    "1. Sign in on Epic's website. The page then shows a short text containing “authorizationCode”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Connecte-toi sur le site d'Epic. La page affiche ensuite un court texte contenant « authorizationCode »."
          }
        }
      }
    },
    "2. Copy that code (or the whole text) and paste it here within a few minutes:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Copie ce code (ou tout le texte) et colle-le ici dans les minutes qui suivent :"
          }
        }
      }
    },
    "4 GB memory for 32-bit games": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 Go de mémoire pour les jeux 32 bits"
          }
        }
      }
    },
    "A bottle is a separate Windows environment managed by Whisky. A dedicated bottle keeps programs apart from your games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bouteille est un environnement Windows séparé, géré par Whisky. Une bouteille dédiée garde les programmes à l'écart de tes jeux."
          }
        }
      }
    },
    "A fixed resolution runs the game in a Wine window of that size: useful when a game picks a wrong resolution or misbehaves in fullscreen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une résolution fixe lance le jeu dans une fenêtre Wine de cette taille : utile quand un jeu choisit une mauvaise résolution ou se comporte mal en plein écran."
          }
        }
      }
    },
    "A folder on an external drive becomes a Windows drive for Steam. Steam can then install new games there (it asks where when you install), or move one with the game's Properties › Installed Files › Move Install Folder. Keep the drive connected while you play those games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier sur un disque externe devient un lecteur Windows pour Steam. Steam peut alors y installer de nouveaux jeux (il demande où à l'installation), ou y déplacer un jeu via Propriétés › Fichiers installés › Déplacer le dossier d'installation. Garde le disque branché quand tu joues à ces jeux."
          }
        }
      }
    },
    "A fullscreen game takes over the display, like on Windows. Turn off to keep other displays and notifications visible.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu en plein écran prend tout l'écran, comme sur Windows. Désactive pour garder les autres écrans et les notifications visibles."
          }
        }
      }
    },
    "A native macOS version exists on Steam: install Steam for Mac to get it. The Windows version stays in the … menu.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version macOS native existe sur Steam : installe Steam pour Mac pour l'obtenir. La version Windows reste dans le menu « … »."
          }
        }
      }
    },
    "A native macOS version exists on Steam: use Steam for Mac rather than Whisky.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version macOS native existe sur Steam : utilisez Steam pour Mac plutôt que Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam にネイティブの macOS 版があります。Whisky ではなく Mac 版 Steam を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 上有原生 macOS 版本：请使用 Mac 版 Steam，而不是 Whisky。"
          }
        }
      }
    },
    "A native macOS version exists on Steam: use Steam for Mac rather than Wine.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version macOS native existe sur Steam : utilise Steam pour Mac plutôt que Wine."
          }
        }
      }
    },
    "A native macOS version exists: Steam for Mac installs it. The Windows version stays in the … menu.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version macOS native existe : Steam pour Mac l'installe. La version Windows reste dans le menu « … »."
          }
        }
      }
    },
    "A text summary of the Mac, the engine and Whisky (no account data) to paste in a bug report.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un résumé texte du Mac, du moteur et de Whisky (sans données de compte) à coller dans un rapport de bug."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos"
          }
        },
        "ja": {
