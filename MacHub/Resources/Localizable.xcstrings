        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Minecraft Launcher n'est pas installé dans Applications."
          }
        }
      }
    },
    "The Steam store, searched on demand. Being on Steam doesn't mean a game runs on Mac.": {
      "localizations": {
