    "Action RPG": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RPG d'action"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション RPG"
          }
