          }
        }
      }
    },
    "What your Mac sees, a quick button test, and what Windows games receive through Whisky.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que voit ton Mac, un test rapide des boutons, et ce que reçoivent les jeux Windows via Whisky."
          }
        }
      }
    },
    "Which program should MacHub open?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel programme MacHub doit-il ouvrir ?"
          }
        }
      }
    },
    "Whisky": {
      "shouldTranslate": false
    },
    "Whisky %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
