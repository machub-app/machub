            "value": "Version macOS native"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ macOS 版"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 macOS 版本"
          }
        }
      }
    },
    "Native macOS version: no Windows engine needed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version macOS native : aucun moteur Windows nécessaire."
          }
        }
      }
    },
    "Needed to install Windows games. Create a bottle in Whisky and install Steam in it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour installer des jeux Windows. Créez une bouteille dans Whisky et installez-y Steam."
