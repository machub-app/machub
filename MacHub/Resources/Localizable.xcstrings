    },
    "Nexus Mods only allows direct downloads for Premium members. Use “Mod Manager Download” on the mod's page.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexus Mods ne permet les téléchargements directs qu'aux membres Premium. Utilise « Mod Manager Download » sur la page du mod."
          }
        }
      }
    },
    "Nexus Mods refused the API key. Check it in Settings › Mods.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexus Mods a refusé la clé API. Vérifie-la dans Réglages › Mods."
          }
        }
      }
    },
    "Nexus page": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page Nexus"
          }
        }
