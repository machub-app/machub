    "Sign Out": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter"
          }
        }
      }
    },
    "Sign in again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reconnecter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度サインイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新登录"
          }
        }
      }
    },
    "Sign in on Steam's own website, in your browser. MacHub never sees your password: it only receives your public SteamID, verified with Steam.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous sur le site de Steam, dans votre navigateur. MacHub ne voit jamais votre mot de passe : il reçoit seulement votre SteamID public, vérifié auprès de Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで Steam の公式サイトにサインインしてください。MacHub がパスワードを見ることはなく、受け取るのは Steam で確認した公開 SteamID だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中登录 Steam 官网。MacHub 永远不会看到你的密码，只会收到经 Steam 验证的公开 SteamID。"
          }
        }
      }
    },
    "Sign in to Steam for Windows and open its Library once: MacHub then reads your games from it. Or add your personal Web API key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à Steam pour Windows et ouvre sa Bibliothèque une fois : MacHub y lit ensuite tes jeux. Ou ajoute ta clé Web API personnelle."
          }
        }
      }
    },
    "Sign in with Steam": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter avec Steam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam でサインイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Steam 登录"
          }
        }
      }
    },
