    "Steam received the launch request. MacHub doesn't check yet whether the game window opened.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam a reçu la demande de lancement. MacHub ne vérifie pas encore si la fenêtre du jeu s'est ouverte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam が起動リクエストを受け取りました。ゲームウィンドウが開いたかどうかは、まだ MacHub では確認していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 已收到启动请求。MacHub 目前还不会检查游戏窗口是否已打开。"
          }
        }
      }
    },
