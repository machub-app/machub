    "Bluetooth trouble: try a USB cable. Some controllers expose more features over USB.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souci de Bluetooth : essaie un câble USB. Certaines manettes offrent plus de fonctions en USB."
          }
        }
      }
    },
