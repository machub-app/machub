    "Try again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "Turn it on if it doesn't light up.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allume-la si elle ne s'éclaire pas."
          }
        }
      }
    },
    "Turn on the Metal performance overlay in Settings › Graphics to measure frame rates: MacHub then shows a summary here after each session.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le compteur de performances Metal dans Réglages › Graphismes pour mesurer les images par seconde : MacHub affichera ici un résumé après chaque session."
          }
        }
      }
    },
    "Turn your controller on and pair it in Bluetooth settings, or plug it in with a USB cable. This page updates by itself as soon as macOS sees it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allume ta manette et appaire-la dans les réglages Bluetooth, ou branche-la avec un câble USB. Cette page se met à jour toute seule dès que macOS la voit."
          }
        }
      }
    },
