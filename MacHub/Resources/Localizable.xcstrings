    "Add a Games Folder on Another Drive…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un dossier de jeux sur un autre disque…"
          }
        }
      }
    },
    "Add a Windows .exe, or pin a program in Whisky: it shows up here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un .exe Windows, ou épinglez un programme dans Whisky : il apparaîtra ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows の .exe を追加するか、Whisky でプログラムをピン留めすると、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Windows .exe，或在 Whisky 中固定程序，它就会显示在这里。"
          }
        }
      }
    },
    "Add a Windows program…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un programme Windows…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows プログラムを追加…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Windows 程序…"
          }
        }
      }
    },
    "Add a car or track…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une voiture ou un circuit…"
          }
        }
      }
    },
    "Add a file or folder…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un fichier ou un dossier…"
          }
        }
      }
    },
    "Add a key in Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une clé dans les Réglages"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でキーを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中添加密钥"
          }
        }
      }
    },
    "Add cars and tracks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des voitures et des circuits"
          }
        }
      }
    },
    "Add to MacHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à MacHub"
          }
        }
      }
    },
    "Add your Nexus Mods API key in Settings › Mods.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ta clé API Nexus Mods dans Réglages › Mods."
          }
        }
      }
    },
    "Add your Steam Web API key to check.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre clé Web API Steam pour vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するには Steam Web API キーを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Steam Web API 密钥以检查。"
          }
        }
      }
    },
    "Added as %@. Steam for Windows lists it next time it starts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté comme %@. Steam pour Windows l'affichera à son prochain démarrage."
          }
        }
      }
    },
    "Added outside MacHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté en dehors de MacHub"
          }
        }
      }
    },
    "Added to Software": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté aux Logiciels"
          }
        }
      }
    },
    "Adds an app for this game to Applications › MacHub Games: open it to play without going through MacHub's window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une app pour ce jeu dans Applications › MacHub Games : ouvre-la pour jouer sans passer par la fenêtre de MacHub."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé"
          }
        }
      }
    },
    "Adventure": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aventure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドベンチャー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冒险"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All categories": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les catégories"
          }
        }
      }
    },
    "All controls received by macOS": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les commandes reçues par macOS"
          }
        }
      }
    },
    "All genres": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les genres"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのジャンル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有类型"
          }
        }
      }
    },
    "Also installs what it requires: %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe aussi ce dont il a besoin : %@."
          }
        }
      }
    },
    "Also removed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Également supprimé"
          }
        }
      }
    },
    "An estimate from public reports, not a promise. Tried it? Report how it ran on MacHub's GitHub page.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation tirée de rapports publics, pas une promesse. Tu l'as essayé ? Raconte-nous sur la page GitHub de MacHub."
          }
        }
      }
    },
    "An installer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un installateur"
          }
        }
      }
    },
    "An update is available": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour est disponible"
          }
        }
      }
    },
    "An update is available. Steam applies it at the next launch, or choose Update Now in the … menu.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour est disponible. Steam l'applique au prochain lancement, ou choisis « Mettre à jour » dans le menu …."
          }
        }
      }
    },
    "Another app already uses this name: %@. MacHub left it untouched.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app porte déjà ce nom : %@. MacHub n'y a pas touché."
          }
        }
      }
    },
    "Anti-cheat": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-triche"
          }
        }
      }
    },
    "Anti-cheat: uncertain": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-triche : incertain"
          }
        }
      }
    },
    "Any compatibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute compatibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての互換性"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意兼容性"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apple's translator, required for DirectX 12. Needs the Game Porting Toolkit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traducteur d'Apple, indispensable pour DirectX 12. Nécessite le Game Porting Toolkit."
          }
        }
      }
    },
    "Applied %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué le %@."
          }
        }
      }
    },
    "Applied. They take effect at the next launch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué. Ils prennent effet au prochain lancement."
          }
        }
      }
    },
    "Apply Recommended Fixes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les correctifs recommandés"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
