            "state": "translated",
            "value": "连接 Steam"
          }
        }
      }
    },
    "Connect Steam and add your Web API key to see the games you own, or install games in a Whisky bottle.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Steam et ajoutez votre clé Web API pour voir vos jeux, ou installez des jeux dans une bouteille Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有ゲームを表示するには Steam に接続して Web API キーを追加するか、Whisky のボトルにゲームをインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Steam 并添加 Web API 密钥即可查看你拥有的游戏，或在 Whisky 容器中安装游戏。"
          }
        }
      }
    },
    "Connect Steam first": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez d'abord Steam"
