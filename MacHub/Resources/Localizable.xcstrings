        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'adresse de téléchargement pour le moteur"
          }
        }
      }
    },
    "No games here yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeu ici pour l'instant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはまだゲームがありません"
