            "value": "名称"
          }
        }
      }
    },
    "Name in MacHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom dans MacHub"
          }
        }
      }
    },
    "Native Mac game: it runs in its own launcher, without Wine.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeu Mac natif : il tourne dans son propre lanceur, sans Wine."
          }
        }
      }
    },
    "Native button labels (SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libellés de boutons natifs (SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1)"
          }
        }
      }
    },
    "Native macOS version": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version macOS native"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ macOS 版"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 macOS 版本"
          }
        }
      }
    },
    "Needed to install Windows games. Create a bottle in Whisky and install Steam in it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour installer des jeux Windows. Créez une bouteille dans Whisky et installez-y Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ゲームのインストールに必要です。Whisky でボトルを作成し、Steam をインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Windows 游戏需要它。请在 Whisky 中创建容器并安装 Steam。"
          }
        }
      }
    },
    "New bottle “%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle bouteille « %@ »"
          }
        }
      }
