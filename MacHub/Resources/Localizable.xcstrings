            "state": "translated",
            "value": "暂时无法搜索 Steam。"
          }
        }
      }
    },
    "Steam connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam connecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
