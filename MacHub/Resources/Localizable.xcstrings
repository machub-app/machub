    "Retina renders at the screen's full resolution: sharper, but up to four times more pixels for the GPU. Background shader compilation removes most DXVK stutter, at the cost of objects popping in for a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retina rend à la pleine résolution de l'écran : plus net, mais jusqu'à quatre fois plus de pixels pour le GPU. La compilation des shaders en arrière-plan supprime la plupart des saccades DXVK, au prix d'objets qui apparaissent avec un léger retard."
          }
        }
      }
    },
    "Retina resolution": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolution Retina"
