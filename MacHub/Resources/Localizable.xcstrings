          "stringUnit": {
            "state": "translated",
            "value": "Installation du moteur…"
          }
        }
      }
    },
    "Integrated with Modrinth: search, details, verified downloads, updates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intégré à Modrinth : recherche, détails, téléchargements vérifiés, mises à jour."
          }
        }
      }
