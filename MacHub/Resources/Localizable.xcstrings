          }
        }
      }
    },
    "System": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "Text editor": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éditeur de texte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストエディタ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本编辑器"
          }
        }
      }
    },
    "That doesn't look like a Steam key (32 hexadecimal characters).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à une clé Steam (32 caractères hexadécimaux)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam のキー（16 進数 32 文字）ではないようです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不像 Steam 密钥（32 位十六进制字符）。"
          }
        }
      }
    },
    "The Steam store, searched on demand. Being on Steam doesn't mean a game runs under Whisky.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Store Steam, interrogé à la demande. Être sur Steam ne signifie pas qu'un jeu fonctionne sous Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときに検索する Steam ストアです。Steam にあっても Whisky で動作するとは限りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需搜索 Steam 商店。在 Steam 上并不代表游戏能在 Whisky 下运行。"
          }
        }
      }
    },
    "The game has closed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu s'est fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏已关闭。"
          }
        }
      }
    },
    "The game started, then closed after %lld s: it most likely crashed at startup. See the requirements and the Wine log.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu a démarré puis s'est fermé au bout de %lld s : il a très probablement planté au lancement. Voir les prérequis et le log Wine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームは起動しましたが %lld 秒で終了しました。起動時にクラッシュした可能性が高いです。必要条件と Wine のログを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏已启动，但 %lld 秒后关闭：很可能在启动时崩溃。请查看前提条件和 Wine 日志。"
          }
        }
      }
    },
    "The program closed (exit code %d).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme s'est fermé (code de sortie %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムが終了しました（終了コード %d）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序已关闭（退出代码 %d）。"
          }
        }
      }
    },
    "The sign-in response was invalid and was ignored.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de connexion était invalide et a été ignorée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインの応答が無効だったため無視しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录响应无效，已忽略。"
          }
        }
      }
    },
    "These bottles come from the original Whisky. “Not set up” means Wine never created the bottle's files, so it can't run anything. MacHub never changes them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces bouteilles viennent du Whisky d'origine. « Non configurée » signifie que Wine n'a jamais créé ses fichiers : elle ne peut rien lancer. MacHub ne les modifie jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは旧 Whisky のボトルです。「未設定」は Wine がボトルのファイルを作成していないため、何も起動できない状態です。MacHub がこれらを変更することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些容器来自原版 Whisky。“未配置”表示 Wine 从未创建该容器的文件，因此无法运行任何程序。MacHub 不会修改它们。"
          }
        }
      }
    },
    "This Whisky is too old for MacHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Whisky est trop ancienne pour MacHub"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Whisky は MacHub には古すぎます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Whisky 版本过旧，无法用于 MacHub"
          }
        }
      }
    },
    "To play, a Whisky bottle with Steam for Windows is needed. See the requirements below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour jouer, il faut une bouteille Whisky avec Steam pour Windows. Voir les prérequis ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイするには、Windows 版 Steam が入った Whisky のボトルが必要です。下の必要条件を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要游玩，需要一个装有 Windows 版 Steam 的 Whisky 容器。请查看下方前提条件。"
          }
        }
      }
    },
    "Top sellers on Steam": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleures ventes sur Steam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam の売上上位"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 热销"
          }
        }
      }
    },
