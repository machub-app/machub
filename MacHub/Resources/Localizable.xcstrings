    "Your Whisky is too old for MacHub. Install the maintained fork (frankea/Whisky).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Whisky est trop ancien pour MacHub. Installez le fork maintenu (frankea/Whisky)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いの Whisky は MacHub には古すぎます。保守されているフォーク (frankea/Whisky) をインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Whisky 版本过旧，无法用于 MacHub。请安装仍在维护的分支 (frankea/Whisky)。"
          }
        }
      }
    },
    "Your game details are private on Steam.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos détails de jeux sont privés sur Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam でゲームの詳細が非公開になっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Steam 上的游戏详情为私密。"
          }
        }
      }
    },
    "Your library is empty": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque est vide"
          }
        },
        "ja": {
