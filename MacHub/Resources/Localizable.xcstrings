    "Rosetta 2 isn't installed. Wine needs it to run on Apple silicon": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 n'est pas installé. Wine en a besoin pour tourner sur puce Apple"
