    "Install a game in a Whisky bottle, or turn demo titles back on in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un jeu dans une bouteille Whisky, ou réactivez les titres de démo dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky のボトルにゲームをインストールするか、設定でデモタイトルを再表示してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Whisky 容器中安装游戏，或在设置中重新开启演示内容。"
          }
        }
      }
    },
    "Install folder": {
      "localizations": {
        "fr": {
          "stringUnit": {
