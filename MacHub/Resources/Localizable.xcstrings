        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有游戏"
          }
        }
      }
    },
    "No installed Steam game found in your bottles yet. Games you install through Steam in Whisky appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeu Steam installé dans vos bouteilles pour l'instant. Les jeux installés via Steam dans Whisky apparaîtront ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボトル内にインストール済みの Steam ゲームはまだありません。Whisky 上の Steam でインストールしたゲームがここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的容器中还没有已安装的 Steam 游戏。通过 Whisky 中的 Steam 安装的游戏会显示在这里。"
          }
        }
      }
    },
    "No installer process appeared within 90 seconds.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun processus d'installation n'est apparu en 90 secondes."
          }
        }
      }
    },
    "No key": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无密钥"
          }
        }
      }
    },
    "No mod installed by MacHub in this profile yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mod installé par MacHub dans ce profil pour l'instant."
          }
        }
      }
    },
    "No mod matches for this Minecraft version.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mod ne correspond à cette version de Minecraft."
          }
        }
      }
    },
    "No new program found": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun nouveau programme trouvé"
          }
        }
      }
    },
    "No process from the game's folder appeared in 3 minutes. Steam may be showing a message in its own window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun processus du dossier du jeu n'est apparu en 3 minutes. Steam affiche peut-être un message dans sa propre fenêtre."
          }
        }
      }
    },
    "No process of the game appeared within 3 minutes. The Wine log may explain why.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun processus du jeu n'est apparu en 3 minutes. Le log Wine peut expliquer pourquoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3 分以内にゲームのプロセスが見つかりませんでした。Wine のログで原因を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 分钟内没有出现游戏进程。Wine 日志可能说明原因。"
          }
        }
      }
    },
    "No programs yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun programme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムはまだありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有程序"
          }
        }
      }
    },
    "No set-up Whisky bottle yet, so there is nothing to check on the Windows side.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune bouteille Whisky configurée pour l'instant : rien à vérifier côté Windows."
          }
        }
      }
    },
    "No store page returned for your region.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune fiche renvoyée pour votre région."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お住まいの地域ではストアページが返されませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你所在地区没有返回商店页面。"
          }
        }
      }
    },
    "No version for Minecraft %@ with Fabric. MacHub won't install it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune version pour Minecraft %@ avec Fabric. MacHub ne l'installera pas."
          }
        }
      }
    },
    "None connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connectée"
          }
        }
      }
    },
    "Not a supported Windows file": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier Windows non pris en charge"
          }
        }
      }
    },
    "Not connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接"
          }
        }
      }
    },
    "Not connected. Sign in on Steam's own website: MacHub never sees your password, only your public SteamID, which it verifies with Steam.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté. Connectez-vous sur le site de Steam : MacHub ne voit jamais votre mot de passe, seulement votre SteamID public, qu'il vérifie auprès de Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未接続です。Steam の公式サイトでサインインしてください。MacHub がパスワードを見ることはなく、受け取るのは Steam で確認した公開 SteamID だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接。请在 Steam 官网登录：MacHub 永远不会看到你的密码，只会收到经 Steam 验证的公开 SteamID。"
          }
        }
      }
    },
    "Not in the games Steam reports for your account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent des jeux que Steam indique pour votre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam が報告するアカウントのゲームに含まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在 Steam 为你的账户报告的游戏中。"
          }
        }
      }
    },
    "Not in your Steam library. Buy or add it on Steam first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent de votre bibliothèque Steam. Achetez-le ou ajoutez-le d'abord sur Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ライブラリにありません。先に Steam で購入または追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在你的 Steam 游戏库中。请先在 Steam 购买或添加。"
          }
        }
      }
    },
    "Not installed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non installé"
          }
        }
      }
    },
    "Not listed in the Windows panel: quit the game and Steam in the bottle, reconnect the controller, then open the panel again. Wine only sees controllers connected when the bottle starts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absente du panneau Windows : quitte le jeu et Steam dans la bouteille, reconnecte la manette, puis rouvre le panneau. Wine ne voit que les manettes connectées au démarrage de la bouteille."
