        }
      }
    },
    "Windows files in Downloads": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers Windows dans Téléchargements"
          }
        }
      }
    },
    "Windows games need Steam's own client for downloads, updates, cloud saves and DRM. MacHub installs Valve's official installer in a separate Windows environment and never sees your password: you sign in in Steam's window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux Windows ont besoin du client Steam pour les téléchargements, les mises à jour, les sauvegardes cloud et les DRM. MacHub installe l'installateur officiel de Valve dans un environnement Windows séparé et ne voit jamais ton mot de passe : tu te connectes dans la fenêtre de Steam."
          }
        }
      }
    },
    "Windows program, 32-bit": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme Windows 32 bits"
          }
        }
      }
    },
    "Windows program, 64-bit": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme Windows 64 bits"
          }
        }
      }
    },
    "Windows programs you added yourself, and programs pinned in Whisky.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les programmes Windows que vous avez ajoutés, et ceux épinglés dans Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で追加した Windows プログラムと、Whisky でピン留めしたプログラム。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己添加的 Windows 程序，以及在 Whisky 中固定的程序。"
          }
        }
      }
    },
    "Windows software": {
      "localizations": {
        "fr": {
          "stringUnit": {
