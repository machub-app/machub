    "Steam applies it at the next launch, or right away with Update Now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam l'applique au prochain lancement, ou tout de suite avec « Mettre à jour maintenant »."
          }
        }
      }
    },
    "Steam can't be reached and nothing is installed yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam est injoignable et rien n'est encore installé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam に接続できず、まだ何もインストールされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Steam，且尚未安装任何内容。"
          }
        }
      }
    },
    "Steam can't be reached. Check your connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam est injoignable. Vérifiez votre connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam に接続できません。接続を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Steam。请检查网络连接。"
          }
        }
      }
    },
    "Steam can't be reached. Check your connection; your installed games still work.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam est injoignable. Vérifiez votre connexion ; vos jeux installés restent accessibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam に接続できません。接続を確認してください。インストール済みのゲームは引き続き使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Steam。请检查网络连接；已安装的游戏仍可使用。"
          }
        }
      }
    },
    "Steam can't be searched right now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche Steam est indisponible pour le moment."
          }
        },
