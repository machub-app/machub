    "Illustrative value for the demo. MacHub has no compatibility data source yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur indicative pour la démo. MacHub n'a pas encore de source de données de compatibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ用の参考値です。MacHub にはまだ互換性データの情報源がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示用的示意值。MacHub 目前还没有兼容性数据来源。"
          }
        }
      }
    },
