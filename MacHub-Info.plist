<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. "Alternate" rank: MacHub appears in Finder's Open With menu
	     for Windows files but never becomes their default app unless the user chooses it in Settings. -->
	<!-- Settings › Sound: per-app volume uses Core Audio process taps, which macOS gates behind this prompt. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>MacHub adjusts the volume of each app you choose (a game, Discord, your browser). The sound is played back at your level and never recorded or saved.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Windows Program</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.windows-executable</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Windows Installer Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.msi-installer</string>
			</array>
		</dict>
	</array>
	<!-- Nexus Mods "Mod Manager Download" links (nxm://): MacHub downloads and installs the file for the user. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Nexus Mods download link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nxm</string>
			</array>
		</dict>
		<!-- Game shortcuts made by MacHub (machub://play/<steam app id>): open MacHub and start the game. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>MacHub game shortcut</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>machub</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
